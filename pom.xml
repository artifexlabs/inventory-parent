<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.artifexlabs.parents</groupId>
    <artifactId>artifex-maven-parent</artifactId>
    <version>2</version>
  </parent>

  <groupId>io.artifexlabs.inventory</groupId>
  <artifactId>inventory-parent</artifactId>
  <version>1-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>${project.artifactId}</name>
  <description>Parent for the LE Inventory project</description>
  <url>${github.url.base}/${project.artifactId}</url>
  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <scm>
    <connection>scm:git:${git.url}</connection>
    <developerConnection>scm:git:${git.url}</developerConnection>
    <url>${git.scm.url}</url>
    <tag>HEAD</tag>
  </scm>
  <issueManagement>
    <url>${issue.management.url}</url>
    <system>GitHub</system>
  </issueManagement>
  <distributionManagement>
    <site>
      <id>central</id>
      <url>${site.target.url}/</url>
    </site>
  </distributionManagement>

  <properties>
    <surefire.failIfNoTests>false</surefire.failIfNoTests>
    <jacoco.max.missed.classes>99</jacoco.max.missed.classes>
    <test.coverage.percentage.required>0</test.coverage.percentage.required>
    <org.infinispan.version>14.0.20.Final</org.infinispan.version>
    <org.infinispan.protostream.version>4.6.5.Final</org.infinispan.protostream.version>
    <zxing.version>3.5.3</zxing.version>
    <bcrypt.version>0.10.2</bcrypt.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- vertx-infinispan's jakarta line targets Infinispan 14 (15 hides
           DefaultCacheManager.getTransport(), 13 is the javax line, and the
           quarkus-bom's commons/protostream overrides must not leak in) —
           pin the whole embedded set coherently. -->
    <dependency>
      <groupId>org.infinispan</groupId>
      <artifactId>infinispan-core-jakarta</artifactId>
      <version>${org.infinispan.version}</version>
    </dependency>
    <dependency>
      <groupId>org.infinispan</groupId>
      <artifactId>infinispan-multimap-jakarta</artifactId>
      <version>${org.infinispan.version}</version>
      </dependency>
      <dependency>
        <groupId>org.infinispan</groupId>
        <artifactId>infinispan-core</artifactId>
        <version>${org.infinispan.version}</version>
      </dependency>
      <dependency>
        <groupId>org.infinispan</groupId>
        <artifactId>infinispan-multimap</artifactId>
        <version>${org.infinispan.version}</version>
      </dependency>
      <dependency>
        <groupId>org.infinispan</groupId>
        <artifactId>infinispan-clustered-lock</artifactId>
        <version>${org.infinispan.version}</version>
      </dependency>
      <dependency>
        <groupId>org.infinispan</groupId>
        <artifactId>infinispan-clustered-counter</artifactId>
        <version>${org.infinispan.version}</version>
      </dependency>
      <dependency>
        <groupId>org.infinispan</groupId>
        <artifactId>infinispan-commons</artifactId>
        <version>${org.infinispan.version}</version>
      </dependency>
      <dependency>
        <groupId>org.infinispan</groupId>
        <artifactId>infinispan-component-annotations</artifactId>
        <version>${org.infinispan.version}</version>
      </dependency>
      <dependency>
        <groupId>org.infinispan.protostream</groupId>
        <artifactId>protostream</artifactId>
        <version>${org.infinispan.protostream.version}</version>
      </dependency>
      <dependency>
        <groupId>org.infinispan.protostream</groupId>
        <artifactId>protostream-types</artifactId>
        <version>${org.infinispan.protostream.version}</version>
      </dependency>
    <dependency><!-- QR rendering happens beside the label printer, in the labels worker -->
      <groupId>com.google.zxing</groupId>
      <artifactId>core</artifactId>
      <version>${zxing.version}</version>
    </dependency>
    <dependency>
      <groupId>com.google.zxing</groupId>
      <artifactId>javase</artifactId>
      <version>${zxing.version}</version>
    </dependency>
    <dependency>
      <groupId>at.favre.lib</groupId>
      <artifactId>bcrypt</artifactId>
      <version>${bcrypt.version}</version>
    </dependency>
    </dependencies>

  </dependencyManagement>
  <dependencies>
    <dependency>
      <groupId>org.json</groupId>
      <artifactId>json</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.infrastructurebuilder</groupId>
      <artifactId>ibexceptions</artifactId>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin><!-- Release ceremony (Phase 19): version managed by the parent
               chain; the tag and profile conventions live here. autoVersion-
               Submodules keeps inventory-impl-root's modules on one version.
               releaseProfiles=release rides ibparent-root's sources/javadoc
               profile plus this pom's GPG signing below. -->
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-release-plugin</artifactId>
          <configuration>
            <tagNameFormat>v@{project.version}</tagNameFormat>
            <releaseProfiles>release</releaseProfiles>
            <autoVersionSubmodules>true</autoVersionSubmodules>
            <signTag>true</signTag>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin><!-- Publishing destination (DECIDED 2026-08-21): Maven Central,
             public, via the Central Portal. This entry ACTIVATES the plugin
             (ibparent-minimal manages version + config but binds nothing)
             and deliberately overrides its managed autoPublish=true:
             a deploy only STAGES the bundle for manual review/publication
             in the portal — nothing goes public without an explicit human
             act. Version comes from the chain's pluginManagement. -->
        <groupId>org.sonatype.central</groupId>
        <artifactId>central-publishing-maven-plugin</artifactId>
        <extensions>true</extensions>
        <configuration>
          <publishingServerId>central</publishingServerId>
          <autoPublish>false</autoPublish>
        </configuration>
      </plugin>
      <plugin><!-- Library jars consumed by the Quarkus apps MUST carry a Jandex
             index (META-INF/jandex.idx): without one, ArC only finds their
             types (producer return types like impl's UserStore) through the
             flaky FacadeClassLoader fallback path — the intermittent
             "Producer method return type not found in index" test-bootstrap
             failures. Indexed jars are deterministic application archives. -->
        <groupId>io.smallrye</groupId>
        <artifactId>jandex-maven-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>make-index</id>
            <goals>
              <goal>jandex</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>flatten</id>
            <phase>process-resources</phase>
            <goals>
              <goal>flatten</goal>
            </goals>
          </execution>
          <execution>
            <id>flatten.clean</id>
            <phase>clean</phase>
            <goals>
              <goal>clean</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
  </plugins>
  </build>

  <profiles>
    <profile>
      <!-- Central requires signed artifacts; the parent chain manages the
           gpg plugin VERSION but binds nothing. Signing uses the owner's
           existing keys via the local gpg-agent — release builds only. -->
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <bestPractices>true</bestPractices>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
